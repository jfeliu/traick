# Local AI (Ollama — https://ollama.ai)
# Run: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama      # set to your secret key if Ollama is exposed publicly
AI_MODEL=qwen2.5:7b

# WhatsApp — Meta Cloud API
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=a_random_string_you_choose   # for webhook verification
TO_PHONE_NUMBER=+1234567890                        # your personal number — reminders sent here

# Whitelist of numbers whose messages are tracked (comma-separated, E.164 format)
# Leave unset or empty to track messages from ALL numbers.
ALLOWED_NUMBERS=+15559876543,+34612345678

# App config (optional — these are the defaults)
DB_PATH=traick.db
BATCH_SIZE=20
PROCESS_INTERVAL_MINUTES=1
REMINDER_INTERVAL_MINUTES=15
